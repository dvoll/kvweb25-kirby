parameters:
	ignoreErrors:
		-
			message: "#^Method dvll\\\\KirbyEvents\\\\Models\\\\EventsPage\\:\\:children\\(\\) return type with generic class Kirby\\\\Cms\\\\Pages does not specify its types\\: TPage$#"
