		-
			message: "#^Call to an undefined method dvll\\\\KirbyEvents\\\\Models\\\\EventPage\\:\\:location\\(\\)\\.$#"
			count: 1
			path: plugins/kirby-events/templates/event.ics.php

		-
			message: "#^Parameter \\#1 \\$uStamp of function iCalDateFormat expects int, DateTimeImmutable given\\.$#"
			count: 2
			path: plugins/kirby-events/templates/event.ics.php

		-
			message: "#^Call to an undefined method dvll\\\\Sitepackage\\\\Models\\\\TeaserBlogpostsBlock\\:\\:showText\\(\\)\\.$#"
