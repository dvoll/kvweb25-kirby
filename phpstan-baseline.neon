			path: plugins/kirby-events/models/EventsPage.php

		-
			message: "#^Left side of && is always false\\.$#"
			count: 1
			path: plugins/kirby-events/services/MockGoogleCalendarService.php

		-
			message: "#^Call to an undefined method dvll\\\\KirbyEvents\\\\Models\\\\EventPage\\:\\:description\\(\\)\\.$#"
			count: 1
